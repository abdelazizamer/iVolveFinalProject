# Copy this file to .env and replace every placeholder before local use.
FRONTEND_PORT=3000
MYSQL_DATABASE=ivolve
MYSQL_USER=ivolve_app
MYSQL_PASSWORD=replace-with-a-local-only-app-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-only-root-password
SESSION_SECRET=replace-with-a-long-random-local-only-session-secret
